# Copy this file to ".env" and fill in your own values. NEVER commit ".env".

# --- Security ---
# Generate one:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
FLASK_DEBUG=false
SESSION_COOKIE_SECURE=false      # set true when the site is served over HTTPS

# --- MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=Healthcare_chat_bot

# --- AI assistant (optional; chatbot still works with built-in safe answers if empty) ---
# Any OpenAI-compatible chat-completions API.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# --- Local emergency & support info (change for your region) ---
EMERGENCY_NUMBER=112
AMBULANCE_NUMBER=108
EXTRA_EMERGENCY_CONTACTS=        # e.g. Police:100;Fire:101;Women helpline:1091
SUPPORT_EMAIL=
SUPPORT_PHONE=
SUPPORT_ADDRESS=
SUPPORT_HOURS=

# --- App behaviour ---
ADMIN_EMAILS=                    # comma-separated emails allowed to register doctors
SLOT_CAPACITY=3                  # max bookings per specialty per time slot
CLINIC_START=09:00
CLINIC_END=17:30
SLOT_MINUTES=30
